<configuration>
  <property><name>stack_name</name><value>GENERIC</value><description>Foundation context identity.</description><on-ambari-upgrade add="true"/></property>
  <property><name>stack_root</name><value>{"GENERIC":"/usr"}</value><description>Foundation software root.</description><on-ambari-upgrade add="true"/></property>
  <property><name>stack_features</name><value>{"GENERIC":{"stack_features":[]}}</value><description>No distribution upgrade features.</description><on-ambari-upgrade add="true"/></property>
  <property><name>stack_tools</name><value>{"GENERIC":{}}</value><description>No distribution selector requirement.</description><on-ambari-upgrade add="true"/></property>
  <property><name>alerts_repeat_tolerance</name><value>1</value><description>Consecutive observations required for a hard alert.</description><on-ambari-upgrade add="true"/></property>
  <property><name>security_enabled</name><value>false</value><description>No implicit Kerberos initialization.</description><on-ambari-upgrade add="true"/></property>
  <property><name>ignore_bad_mounts</name><value>false</value><description>Mount validation policy.</description><on-ambari-upgrade add="true"/></property>
  <property><name>manage_dirs_on_root</name><value>true</value><description>Directory ownership policy.</description><on-ambari-upgrade add="true"/></property>
  <property><name>repo_suse_rhel_template</name><value>[{{repo_id}}]
name={{repo_id}}
baseurl={{base_url}}
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rockyofficial
</value><description>Repository template.</description><on-ambari-upgrade add="true"/></property>
  <property><name>repo_ubuntu_template</name><value>deb {{base_url}} {{components}}
</value><description>Repository template.</description><on-ambari-upgrade add="true"/></property>
</configuration>
