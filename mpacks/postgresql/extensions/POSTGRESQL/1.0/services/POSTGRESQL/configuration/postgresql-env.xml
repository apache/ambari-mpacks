<configuration>
  <property><name>database</name><value>postgres</value><description>Source database identity.</description><on-ambari-upgrade add="true"/></property>
  <property><name>unit</name><value></value><description>OS-managed PostgreSQL unit; empty selects the platform default.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>backup_directory</name><value></value><description>Protected backup storage; empty selects ambari-backups below the platform PostgreSQL data root.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>restore_database</name><value></value><description>Explicit isolated recovery target; the source cannot be selected.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>backup_id</name><value></value><description>Exact backup UUID selected for recovery.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
</configuration>
