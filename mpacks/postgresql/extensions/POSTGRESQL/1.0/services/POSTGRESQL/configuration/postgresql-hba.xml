<configuration supports_adding_forbidden="true">
  <property>
    <name>content</name>
    <display-name>pg_hba.conf</display-name>
    <value># Keep local peer access for the postgres OS account used by Ambari.
# TYPE  DATABASE  USER      ADDRESS         METHOD
local   all       postgres                  peer
local   all       all                       peer
host    all       all       127.0.0.1/32     scram-sha-256
host    all       all       ::1/128          scram-sha-256
</value>
    <description>Complete pg_hba.conf. Keep the documented management placeholders and local health access. Save a configuration version and restart the service to apply. Nginx also supports RELOAD.</description>
    <value-attributes><type>content</type><property-file-name>pg_hba.conf</property-file-name><property-file-type>pg-hba</property-file-type></value-attributes>
    <on-ambari-upgrade add="true"/>
  </property>
</configuration>
