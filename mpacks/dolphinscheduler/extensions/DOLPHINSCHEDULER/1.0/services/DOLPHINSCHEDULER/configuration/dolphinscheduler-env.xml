<configuration>
  <property><name>server_host</name><value></value><description>Derived from the assigned DolphinScheduler Server.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>api_port</name><value>12345</value><description>DolphinScheduler API and UI port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_host</name><value></value><description>External dedicated PostgreSQL 14-18 host.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_port</name><value>5432</value><description>PostgreSQL port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_name</name><value>dolphinscheduler</value><description>Dedicated empty metadata database owned by the configured user.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_user</name><value>dolphinscheduler</value><description>Metadata database owner.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_password</name><value></value><description>Explicit database password, at least twelve characters.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>zookeeper_host</name><value></value><description>External ZooKeeper host; test-mode embedded ZooKeeper is not used.</description><on-ambari-upgrade add="true"/></property>
  <property><name>zookeeper_port</name><value>2181</value><description>External ZooKeeper port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>admin_password</name><value></value><description>Explicit administrator password, 12-20 characters. Replaces the upstream default at first initialization.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>java_home</name><value>/usr/lib/jvm/java-17-openjdk</value><description>Java 11 or 17 runtime used by the four supervised processes.</description><on-ambari-upgrade add="true"/></property>
  <property><name>binary_url</name><value></value><description>Optional HTTPS mirror of the pinned official binary archive. The SHA-512 must match.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
</configuration>
