<configuration supports_adding_forbidden="true">
  <property>
    <name>content</name>
    <display-name>kyuubi-env.sh</display-name>
    <value># Edit the native configuration below. Save a version and restart to apply.
KYUUBI_JAVA_OPTS='-Xmx768m'
SPARK_LOCAL_DIRS='/var/lib/kyuubi/work'
</value>
    <description>Complete environment configuration. Existing scalar properties are converted using their current values when opening the current configuration version. Management identity and listener settings remain in Basic Settings.</description>
    <value-attributes><type>content</type><empty-value-valid>true</empty-value-valid><property-file-name>kyuubi-env.sh</property-file-name><property-file-type>environment</property-file-type></value-attributes>
    <on-ambari-upgrade add="true"/>
  </property>
</configuration>
