<configuration supports_adding_forbidden="true">
  <property>
    <name>content</name>
    <display-name>log4j2.properties</display-name>
    <value>rootLogger.level = info
rootLogger.appenderRef.console.ref = console
appender.console.type = Console
appender.console.name = console
appender.console.layout.type = PatternLayout
appender.console.layout.pattern = %d{ISO8601} %-5p %c - %m%n
</value>
    <description>Complete log4j2.properties. Changes take effect after restart.</description>
    <value-attributes><type>content</type><empty-value-valid>true</empty-value-valid></value-attributes>
    <on-ambari-upgrade add="true"/>
  </property>
</configuration>
