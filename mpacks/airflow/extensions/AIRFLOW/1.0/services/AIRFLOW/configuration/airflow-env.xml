<configuration>
  <property><name>server_host</name><value></value><description>Leave empty to use the assigned Airflow Server host. All four LocalExecutor processes run there.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>api_port</name><value>8085</value><description>Airflow API and UI port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_host</name><value></value><description>External PostgreSQL 14-18 host. PostgreSQL 10 from the reference store is not supported.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_port</name><value>5432</value><description>Metadata database port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_name</name><value>airflow</value><description>Dedicated empty metadata database. Create the database and owner before initialization.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_user</name><value>airflow</value><description>Metadata database owner.</description><on-ambari-upgrade add="true"/></property>
  <property><name>database_password</name><value></value><description>Metadata database password; at least twelve characters.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>admin_username</name><value>admin</value><description>Administrator created by the explicit CREATE_ADMIN action.</description><on-ambari-upgrade add="true"/></property>
  <property><name>admin_password</name><value></value><description>Explicit administrator password; at least twelve characters.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>admin_email</name><value></value><description>Administrator email address.</description><on-ambari-upgrade add="true"/></property>
  <property><name>parallelism</name><value>2</value><description>Maximum LocalExecutor task parallelism.</description><on-ambari-upgrade add="true"/></property>
</configuration>
