<metainfo><schemaVersion>2.0</schemaVersion><services><service>
  <name>AIRFLOW</name><displayName>Apache Airflow</displayName><version>3.3.2</version>
  <comment>LocalExecutor on one host; external PostgreSQL 14-18 required. Initialize the database and create an administrator explicitly before service checks.</comment>
  <components><component><name>AIRFLOW_SERVER</name><displayName>Airflow Server</displayName><category>MASTER</category><cardinality>1</cardinality><versionAdvertised>false</versionAdvertised><commandScript><script>scripts/server.py</script><scriptType>PYTHON</scriptType><timeout>1800</timeout></commandScript><customCommands><customCommand><name>INITIALIZE_DATABASE</name><commandScript><script>scripts/server.py</script><scriptType>PYTHON</scriptType><timeout>1800</timeout></commandScript></customCommand><customCommand><name>CREATE_ADMIN</name><commandScript><script>scripts/server.py</script><scriptType>PYTHON</scriptType><timeout>1800</timeout></commandScript></customCommand><customCommand><name>VERSION_CHECK</name><commandScript><script>scripts/server.py</script><scriptType>PYTHON</scriptType><timeout>1800</timeout></commandScript></customCommand></customCommands></component></components>
  <osSpecifics><osSpecific><osFamily>redhat8</osFamily><packages><package><name>python3.11</name></package><package><name>python3.11-pip</name></package><package><name>python3-dbus</name></package><package><name>python3-gobject-base</name></package></packages></osSpecific></osSpecifics>
  <commandScript><script>scripts/service_check.py</script><scriptType>PYTHON</scriptType><timeout>600</timeout></commandScript>
  <configuration-dependencies><config-type>airflow-env</config-type><config-type>airflow-settings</config-type><config-type>airflow-webserver</config-type></configuration-dependencies>
  <quickLinksConfigurations><quickLinksConfiguration><fileName>quicklinks.json</fileName><default>true</default></quickLinksConfiguration></quickLinksConfigurations>
<themes><theme><fileName>theme.json</fileName><default>true</default></theme></themes>
</service></services></metainfo>
