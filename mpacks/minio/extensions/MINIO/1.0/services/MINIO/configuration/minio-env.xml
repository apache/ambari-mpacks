<configuration>
  <property><name>server_host</name><value></value><description>Derived from the assigned MinIO Server.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>api_port</name><value>9000</value><description>S3 API port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>console_port</name><value>9001</value><description>Embedded MinIO Console port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>data_directory</name><value>/var/lib/minio/data</value><description>Persistent single-node object data. Definition removal does not delete it.</description><on-ambari-upgrade add="true"/></property>
  <property><name>root_user</name><value></value><description>Explicit MinIO root access key; no default credential is installed.</description><on-ambari-upgrade add="true"/></property>
  <property><name>root_password</name><value></value><description>Explicit MinIO root secret key; minimum twelve characters.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>go_home</name><value>/usr/local/go</value><description>Go installation able to select toolchain 1.24.8. The exact built Linux/ARM64 binary digest is verified.</description><on-ambari-upgrade add="true"/></property>
  <property><name>source_url</name><value></value><description>Optional HTTPS mirror of the pinned source archive. Its SHA-512 must match.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
</configuration>
