<metainfo><schemaVersion>2.0</schemaVersion><services><service>
  <name>DORIS</name><displayName>Apache Doris</displayName><version>4.1.4</version>
  <comment>One FE and one BE on the same or separate Rocky 8 ARM64 hosts. HA and automatic scale-out are not provided.</comment>
  <components>
    <component><name>DORIS_FE</name><displayName>Doris FE</displayName><category>MASTER</category><cardinality>1</cardinality><versionAdvertised>false</versionAdvertised><commandScript><script>scripts/fe.py</script><scriptType>PYTHON</scriptType><timeout>7200</timeout></commandScript><customCommands><customCommand><name>VERSION_CHECK</name><commandScript><script>scripts/fe.py</script><scriptType>PYTHON</scriptType><timeout>7200</timeout></commandScript></customCommand></customCommands></component>
    <component><name>DORIS_BE</name><displayName>Doris BE</displayName><category>SLAVE</category><cardinality>1</cardinality><versionAdvertised>false</versionAdvertised><commandScript><script>scripts/be.py</script><scriptType>PYTHON</scriptType><timeout>7200</timeout></commandScript><customCommands><customCommand><name>VERSION_CHECK</name><commandScript><script>scripts/be.py</script><scriptType>PYTHON</scriptType><timeout>7200</timeout></commandScript></customCommand></customCommands></component>
  </components>
  <osSpecifics><osSpecific><osFamily>redhat8</osFamily><packages><package><name>java-17-openjdk-devel</name></package><package><name>python3-PyMySQL</name></package><package><name>python3-dbus</name></package><package><name>python3-gobject-base</name></package></packages></osSpecific></osSpecifics>
  <commandScript><script>scripts/service_check.py</script><scriptType>PYTHON</scriptType><timeout>900</timeout></commandScript>
  <configuration-dependencies><config-type>doris-env</config-type><config-type>doris-be</config-type><config-type>doris-fe</config-type></configuration-dependencies>
