<configuration>
  <property><name>fe_host</name><value></value><description>Derived from the assigned Doris FE.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>be_host</name><value></value><description>Derived from the assigned Doris BE.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>fe_http_port</name><value>8030</value><description>FE web and HTTP port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>fe_rpc_port</name><value>9020</value><description>FE RPC port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>fe_query_port</name><value>9030</value><description>FE MySQL-compatible query port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>fe_edit_log_port</name><value>9010</value><description>FE edit-log port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>be_port</name><value>9060</value><description>BE service port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>be_http_port</name><value>8040</value><description>BE HTTP port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>be_heartbeat_port</name><value>9050</value><description>BE heartbeat port registered with FE.</description><on-ambari-upgrade add="true"/></property>
  <property><name>be_brpc_port</name><value>8060</value><description>BE BRPC port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>java_home</name><value>/usr/lib/jvm/java-17-openjdk</value><description>Java 17 runtime used by FE and BE integration.</description><on-ambari-upgrade add="true"/></property>
  <property><name>fe_heap_size</name><value>2G</value><description>FE JVM maximum heap.</description><on-ambari-upgrade add="true"/></property>
  <property><name>be_memory_limit</name><value>2G</value><description>BE process memory limit.</description><on-ambari-upgrade add="true"/></property>
  <property><name>root_password</name><value></value><description>Explicit Doris root password applied on initial FE startup.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>binary_url</name><value></value><description>Optional HTTPS mirror of the pinned 4.1.4 ARM64 distribution; the SHA-512 must match.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
</configuration>
