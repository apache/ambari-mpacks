<configuration>
  <property><name>node_host</name><value></value><description>Derived from the assigned Elasticsearch Node and included in its TLS certificate.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>cluster_name</name><value>ambari_elasticsearch</value><description>Stable single-node cluster identity.</description><on-ambari-upgrade add="true"/></property>
  <property><name>http_port</name><value>9200</value><description>Authenticated HTTPS API port.</description><on-ambari-upgrade add="true"/></property>
  <property><name>transport_port</name><value>9300</value><description>TLS transport port, reserved for this single node.</description><on-ambari-upgrade add="true"/></property>
  <property><name>data_directory</name><value>/var/lib/elasticsearch/ambari/data</value><description>Persistent Elasticsearch data; not removed when definitions retire.</description><on-ambari-upgrade add="true"/></property>
  <property><name>heap_size</name><value>1G</value><description>Explicit JVM heap. Ensure the host has additional filesystem cache and off-heap memory.</description><on-ambari-upgrade add="true"/></property>
  <property><name>admin_password</name><value></value><description>Explicit elastic administrator password, at least twelve characters; no generated password is read from logs.</description><property-type>PASSWORD</property-type><value-attributes><type>password</type></value-attributes><on-ambari-upgrade add="true"/></property>
  <property><name>binary_url</name><value></value><description>Optional HTTPS mirror of the pinned official Linux/ARM64 archive. The SHA-512 must match.</description><value-attributes><empty-value-valid>true</empty-value-valid></value-attributes><on-ambari-upgrade add="true"/></property>
</configuration>
